# Copy to .env for local development. On Railway, set these as service variables.

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres connection string. `docker compose up -d` gives you this one locally.
# On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://aether:aether@localhost:5432/aether

# Long random string used to sign session cookies. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Set to true when connecting to Postgres over a public URL that requires SSL.
DATABASE_SSL=false

# Signing in with Google as this email always grants admin, even without an invite.
# Use it to bootstrap the first admin on a fresh database.
ADMIN_EMAIL=

# Sets this password on the ADMIN_EMAIL account at startup (creating it if needed),
# so the first admin can sign in with email before Google is set up. At least 10
# characters. Remove it after signing in, or it resets the password on every restart.
ADMIN_PASSWORD=

# Google sign-in. Create an OAuth client (Web application) in Google Cloud Console
# with the redirect URI {PUBLIC_URL}/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public base URL. Railway sets RAILWAY_PUBLIC_DOMAIN automatically, so this is
# only needed for a custom domain. Locally it defaults to http://localhost:3001.
PUBLIC_URL=

PORT=3001

# Folder for uploaded files. On Railway, attach a volume at /data and set /data/files.
# Leave blank to allow links only (no uploads).
FILES_DIR=
# Largest upload allowed, in MB.
MAX_UPLOAD_MB=25

# ── Odyssey integration (see docs/ODYSSEY_API.md) ────────────────────────────
# Odyssey's base URL and the service key Odyssey accepts (its AETHER_SERVICE_KEY).
ODYSSEY_API_URL=
ODYSSEY_API_KEY=
ODYSSEY_SYNC_MINUTES=15

# ── Notifications and environment ────────────────────────────────────────────
# production (default), staging or development. Non-production shows a banner.
APP_ENV=
# Slack incoming webhook for notifications and the daily digest.
SLACK_WEBHOOK_URL=
# Hour (UTC) after which the daily digest is sent. 14 = 9am Central.
DIGEST_HOUR_UTC=14

# ── Tests ─────────────────────────────────────────────────────────────────────
# A separate database the test suite may wipe. Tests that need it are skipped when unset.
TEST_DATABASE_URL=postgres://aether:aether@localhost:5432/aether_test
